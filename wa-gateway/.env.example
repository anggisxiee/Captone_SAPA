# Alamat dan port gateway. Biarkan 127.0.0.1: gateway tidak boleh terbuka ke internet.
HOST=127.0.0.1
PORT=3001

# Token rahasia bersama. WAJIB sama dengan WHATSAPP_WEBHOOK_TOKEN di .env Laravel.
# Dipakai di dua arah (header X-Gateway-Token). Minimal 12 karakter.
GATEWAY_TOKEN=

# Webhook Laravel tempat pesan masuk dan status sesi diteruskan.
LARAVEL_WEBHOOK_URL=http://127.0.0.1:8000/api/webhook/whatsapp

# Folder kredensial sesi. Harus permanen (jangan dihapus saat deploy)
# agar nomor tidak meminta pindai QR ulang setiap restart.
AUTH_DIR=./auth

# Lama menunggu QR pertama dari WhatsApp (milidetik).
QR_TIMEOUT_MS=20000

LOG_LEVEL=info
