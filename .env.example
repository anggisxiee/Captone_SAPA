APP_NAME="SAPA Asentra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Gateway WhatsApp ---
# fake    = simulasi tanpa WhatsApp sungguhan (pengembangan dan tes)
# baileys = layanan wa-gateway di folder wa-gateway/ (WhatsApp sungguhan)
WHATSAPP_DRIVER=fake
# Token rahasia bersama untuk webhook (header X-Gateway-Token).
# Dipakai di dua arah, dan harus sama dengan GATEWAY_TOKEN di wa-gateway/.env.
# Kosong = semua webhook ditolak. Isi dengan string acak, mis. `php -r "echo bin2hex(random_bytes(24));"`
WHATSAPP_WEBHOOK_TOKEN=

# Alamat layanan wa-gateway (hanya untuk driver baileys)
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001

# --- AI (penyedia kompatibel OpenAI, mis. SumoPod) ---
# fake   = simulasi tanpa penyedia (pengembangan dan tes)
# openai = penyedia sungguhan; isi AI_API_KEY
AI_DRIVER=fake
AI_BASE_URL=https://ai.sumopod.com/v1
AI_MODEL=gpt-4o-mini
# Kunci API: JANGAN di-commit atau dibagikan. Buat di dashboard penyedia dan beri batas anggaran.
# Alternatifnya simpan lewat halaman Pengaturan AI (terenkripsi di basis data).
AI_API_KEY=
# Artikel dengan skor relevansi di bawah ambang ini tidak dipakai AI.
AI_AMBANG_RELEVANSI=0.50
# Ambang untuk kutipan artikel saat penyedia AI tidak dapat dipakai (tanpa penilaian AI).
AI_AMBANG_RELEVANSI_ATURAN=0.70
# Pesan pelanggan yang masuk diproses mesin jawaban (saran atau balasan otomatis, sesuai Mode AI tiap nomor).
AI_PROSES_PESAN_MASUK=true
# Pengaman sementara: maksimal balasan otomatis AI per percakapan per jam.
AI_MAKS_BALASAN_PER_JAM=20
